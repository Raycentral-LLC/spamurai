{
  "manifest_version": 3,
  "name": "Spamurai YouTube",
  "description": "Skips video ads and hides ad slots on YouTube in Safari. Requires Spamurai Pro.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube.js"],
      "css": ["youtube.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging"],
  "host_permissions": ["*://*.youtube.com/*"]
}
